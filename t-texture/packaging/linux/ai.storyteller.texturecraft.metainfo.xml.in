<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.texturecraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>TextureCraft</name>
  <summary>Paint PBR textures directly on 3D meshes</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      TextureCraft is an open-source, native 3D texture painter that works the way texture artists
      expect: familiar menus, shortcuts, panels and tools, with texture sets,
      layers, masks, fills and effects painted straight onto the model.
    </p>
    <ul>
      <li>Open glTF/GLB, FBX, COLLADA, USD (USDA/USDC/USDZ), Alembic, OBJ, PLY and STL meshes and save projects as .tcraft</li>
      <li>Paint base colour, roughness, metallic, normal and height together with PBR brushes</li>
      <li>Bake mesh maps and export texture sets as PNG, EXR, TGA, JPEG or TIFF</li>
      <li>Every action is a command, scriptable from a CLI and a JSON control channel</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.texturecraft.desktop</launchable>
  <icon type="stock">ai.storyteller.texturecraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/texturecraft</url>
  <url type="bugtracker">https://github.com/storytold/texturecraft/issues</url>
  <url type="help">https://github.com/storytold/texturecraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>3DGraphics</category>
  </categories>
  <keywords>
    <keyword>texture painting</keyword>
    <keyword>pbr</keyword>
    <keyword>3d</keyword>
    <keyword>mesh</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f0c39c</color>
    <color type="primary" scheme_preference="dark">#8f4416</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>texturecraft</binary>
    <mediatype>application/x-texturecraft</mediatype>
    <mediatype>model/gltf-binary</mediatype>
    <mediatype>model/gltf+json</mediatype>
    <mediatype>model/x-fbx</mediatype>
    <mediatype>model/vnd.collada+xml</mediatype>
    <mediatype>model/x-usd</mediatype>
    <mediatype>model/vnd.usda</mediatype>
    <mediatype>model/vnd.usdz+zip</mediatype>
    <mediatype>model/x-alembic</mediatype>
    <mediatype>model/obj</mediatype>
    <mediatype>model/x-ply</mediatype>
    <mediatype>model/stl</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
